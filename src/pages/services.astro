---
// /services/ moved to /freelance/ (GitHub Pages has no server redirects).
import { url } from '../utils';
const target = url('/freelance/');
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <title>Moved to /freelance/</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <a href={target}>This page has moved to /freelance/</a>
  </body>
</html>
