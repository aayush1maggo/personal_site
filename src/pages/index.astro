---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProofBar from '../components/ProofBar.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ToolCards from '../components/ToolCards.astro';
import CaseCard from '../components/CaseCard.astro';
import Process from '../components/Process.astro';
import Skills from '../components/Skills.astro';
import ContactSection from '../components/ContactSection.astro';
import { BOOKING_URL, EMAIL, LINKEDIN_URL } from '../config';
import { url } from '../utils';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const home = new URL(url('/'), Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${home}#person`,
    name: 'Aayush Maggo',
    jobTitle: 'SEO, Analytics and AI Search Specialist',
    url: home,
    email: `mailto:${EMAIL}`,
    sameAs: [LINKEDIN_URL],
    address: { '@type': 'PostalAddress', addressLocality: 'Sydney', addressRegion: 'NSW', addressCountry: 'AU' },
    knowsAbout: ['Search engine optimisation', 'Technical SEO', 'Answer engine optimisation', 'Generative engine optimisation', 'Google Analytics 4', 'Conversion rate optimisation'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${home}#service`,
    name: 'Aayush Maggo – SEO, Analytics and AI Search',
    url: home,
    email: EMAIL,
    founder: { '@id': `${home}#person` },
    areaServed: 'AU',
    address: { '@type': 'PostalAddress', addressLocality: 'Sydney', addressRegion: 'NSW', addressCountry: 'AU' },
    serviceType: ['Technical SEO', 'AI search visibility (AEO/GEO)', 'Analytics & tracking', 'CRO & experimentation'],
  },
];
---

<Base
  title="Aayush Maggo – SEO, Analytics and AI Search"
  description="Sydney freelance SEO, GA4 tracking and AI-search visibility specialist. 10+ years across AKQA, R/GA and independent clients. Book a free 30-minute call."
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section id="top" class="container hero">
    <div class="stack stack--28">
      <div class="eyebrow">
        <span class="marker" aria-hidden="true"></span>
        <span>Sydney · Freelance SEO &amp; analytics</span>
      </div>
      <h1 class="h-hero">Get found on Google <span class="accent">and</span> in AI answers. Then prove it worked.</h1>
      <p class="lede">
        SEO, GA4 tracking and AI-search visibility for growing brands, from a specialist with 10+ years across AKQA,
        R/GA and independent clients. Strategy, implementation and the tooling to measure it.
      </p>
      <div class="btn-row">
        <a class="btn btn--dark" href={BOOKING_URL} data-booking data-cta="hero">Book a free 30-min call</a>
        <a class="btn btn--outline" href={url('/work/')} data-cta="hero-work">See case studies</a>
      </div>
    </div>

    <div class="panel panel--raised" aria-label="Illustrative visibility monitor">
      <div class="monitor__head">
        <span>VISIBILITY MONITOR</span>
        <span>Illustrative</span>
      </div>
      <div class="monitor__rows">
        <div class="monitor__row">
          <span class="monitor__label">Google organic rankings</span>
          <svg aria-hidden="true" width="120" height="32" viewBox="0 0 120 32" fill="none"><polyline points="0,28 20,24 40,25 60,17 80,14 100,8 120,4" stroke="#101915" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>
          <span class="monitor__note">Keyword positions, tracked daily in BigQuery</span>
        </div>
        <div class="monitor__row">
          <span class="monitor__label">AI answer citations</span>
          <svg aria-hidden="true" width="120" height="32" viewBox="0 0 120 32" fill="none"><polyline points="0,26 20,27 40,22 60,20 80,12 100,10 120,6" stroke="#D9480F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>
          <span class="monitor__note">Brand mentions in ChatGPT, Gemini, Perplexity</span>
        </div>
        <div class="monitor__row">
          <span class="monitor__label">GA4 conversions</span>
          <svg aria-hidden="true" width="120" height="32" viewBox="0 0 120 32" fill="none"><rect x="0" y="20" width="12" height="12" rx="2" fill="#C9CEC5"></rect><rect x="18" y="16" width="12" height="16" rx="2" fill="#C9CEC5"></rect><rect x="36" y="18" width="12" height="14" rx="2" fill="#C9CEC5"></rect><rect x="54" y="12" width="12" height="20" rx="2" fill="#C9CEC5"></rect><rect x="72" y="9" width="12" height="23" rx="2" fill="#C9CEC5"></rect><rect x="90" y="5" width="12" height="27" rx="2" fill="#101915"></rect><rect x="108" y="2" width="12" height="30" rx="2" fill="#101915"></rect></svg>
          <span class="monitor__note">Clean tracking from click to lead</span>
        </div>
      </div>
    </div>
  </section>

  <ProofBar />

  <!-- SERVICES -->
  <section id="services" class="container section">
    <div class="section-head">
      <h2 class="h-section measure-h">Four ways I help brands grow</h2>
      <p class="muted measure-p">
        Start with a fixed-price audit, or bring me in for ongoing work. Either way, every recommendation ties back to a number.
      </p>
    </div>
    <ServiceCards />
  </section>

  <!-- LAB -->
  <section id="lab" class="band-dark">
    <div class="container section section--dark-pad">
      <div class="stack stack--16 measure">
        <span class="eyebrow">The lab</span>
        <h2 class="h-section">I don't just use SEO tools. I build them.</h2>
        <p class="muted">Custom tooling means faster research, cheaper reporting and data you own, not data rented from a SaaS dashboard.</p>
      </div>
      <ToolCards />
      <a class="btn btn--light self-start" href={url('/contact/?goal=AI+search+visibility')} data-cta="lab">Check your brand's AI visibility, free</a>
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section id="work" class="container section">
    <h2 class="h-section">Selected work</h2>
    <div class="grid grid--320">
      {work.map((entry) => <CaseCard entry={entry} />)}
    </div>
  </section>

  <Process />

  <!-- ABOUT -->
  <section id="about" class="band-alt">
    <div class="container about">
      <div class="photo">[YOUR PHOTO]</div>
      <div class="stack">
        <span class="eyebrow">About</span>
        <h2 class="h-section">Hi, I'm Aayush.</h2>
        <p class="body-soft">
          I've spent 10+ years in search and analytics: eCommerce SEO in Chandigarh, measurement and experimentation at
          AKQA and R/GA in Melbourne, and now independent work from Sydney.
        </p>
        <p class="body-soft">
          Agency pedigree, freelancer focus. You work with me directly, and I bring the engineering skills to build what
          off-the-shelf tools can't.
        </p>
        <Skills />
      </div>
    </div>
  </section>

  <ContactSection />
</Base>
