---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProofBar from '../components/ProofBar.astro';
import Experience from '../components/Experience.astro';
import Credentials from '../components/Credentials.astro';
import FreelanceCards from '../components/FreelanceCards.astro';
import ToolCards from '../components/ToolCards.astro';
import CaseCard from '../components/CaseCard.astro';
import CvButton from '../components/CvButton.astro';
import Photo from '../components/Photo.astro';
import ContactSection from '../components/ContactSection.astro';
import { EMAIL, LINKEDIN_URL, OPEN_TO } from '../config';
import { url } from '../utils';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const home = new URL(url('/'), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${home}#person`,
  name: 'Aayush Maggo',
  jobTitle: 'Senior SEO & AI Search Specialist',
  url: home,
  email: `mailto:${EMAIL}`,
  sameAs: [LINKEDIN_URL],
  address: { '@type': 'PostalAddress', addressLocality: 'Sydney', addressRegion: 'NSW', addressCountry: 'AU' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Federation University Australia' },
    { '@type': 'CollegeOrUniversity', name: 'Kalinga University' },
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Senior SEO Specialist',
    occupationLocation: { '@type': 'City', name: 'Sydney' },
    skills: 'Technical SEO, AI search optimisation (GEO/AEO), keyword research, content strategy, Python, BigQuery',
  },
  knowsAbout: ['AI search optimisation', 'Generative engine optimisation', 'Answer engine optimisation', 'Search engine optimisation', 'Technical SEO', 'Keyword research'],
};
---

<Base
  title="Aayush Maggo | Senior SEO & AI Search Specialist, Sydney"
  description="Senior SEO and AI search specialist in Sydney with 10+ years across AKQA, R/GA and agency teams. Open to senior SEO roles. Download my CV."
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section id="top" class="container hero">
    <div class="stack stack--28">
      <div class="eyebrow">
        <span class="marker marker--pulse" aria-hidden="true"></span>
        <span>{OPEN_TO}</span>
      </div>
      <h1 class="h-hero">Senior SEO &amp; AI search specialist. <span class="accent">I build the tools too.</span></h1>
      <p class="lede">
        10+ years in search across AKQA, R/GA and agency teams. Technical SEO, GEO/AEO and content strategy, backed by
        the Python, BigQuery and AI-agent skills to automate the heavy lifting.
      </p>
      <div class="btn-row">
        <CvButton location="hero" />
        <a class="btn btn--outline" href="#experience" data-cta="hero-experience">View experience</a>
      </div>
    </div>

    <div class="panel panel--raised" aria-label="What I work on">
      <div class="monitor__head">
        <span>WHAT I WORK ON</span>
        <span>Illustrative</span>
      </div>
      <div class="monitor__rows">
        <div class="monitor__row">
          <span class="monitor__label">Google organic rankings</span>
          <svg aria-hidden="true" width="120" height="32" viewBox="0 0 120 32" fill="none"><polyline points="0,28 20,24 40,25 60,17 80,14 100,8 120,4" stroke="#101915" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>
          <span class="monitor__note">Technical SEO, content and rank tracking in BigQuery</span>
        </div>
        <div class="monitor__row">
          <span class="monitor__label">AI answer citations</span>
          <svg aria-hidden="true" width="120" height="32" viewBox="0 0 120 32" fill="none"><polyline points="0,26 20,27 40,22 60,20 80,12 100,10 120,6" stroke="#D9480F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>
          <span class="monitor__note">Brand visibility in ChatGPT, Gemini, Perplexity</span>
        </div>
        <div class="monitor__row">
          <span class="monitor__label">Automation</span>
          <svg aria-hidden="true" width="120" height="32" viewBox="0 0 120 32" fill="none"><rect x="0" y="20" width="12" height="12" rx="2" fill="#C9CEC5"></rect><rect x="18" y="16" width="12" height="16" rx="2" fill="#C9CEC5"></rect><rect x="36" y="18" width="12" height="14" rx="2" fill="#C9CEC5"></rect><rect x="54" y="12" width="12" height="20" rx="2" fill="#C9CEC5"></rect><rect x="72" y="9" width="12" height="23" rx="2" fill="#C9CEC5"></rect><rect x="90" y="5" width="12" height="27" rx="2" fill="#101915"></rect><rect x="108" y="2" width="12" height="30" rx="2" fill="#101915"></rect></svg>
          <span class="monitor__note">AI agents for research, briefs and audits</span>
        </div>
      </div>
    </div>
  </section>

  <ProofBar />

  <!-- EXPERIENCE -->
  <section id="experience" class="container section">
    <div class="section-head">
      <h2 class="h-section measure-h">Experience</h2>
      <p class="muted measure-p">
        Agency, consultancy and in-the-weeds technical work, from eCommerce SEO in 2014 to AI search today.
      </p>
    </div>
    <Experience />
    <div class="btn-row">
      <CvButton location="experience" label="Download the full CV" />
      <a class="btn btn--outline" href={LINKEDIN_URL} data-cta="experience-linkedin">LinkedIn</a>
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section id="skills" class="band-alt">
    <div class="container section section--tight">
      <h2 class="h-section">Skills, education &amp; awards</h2>
      <Credentials />
    </div>
  </section>

  <!-- LAB -->
  <section id="lab" class="band-dark">
    <div class="container section section--dark-pad">
      <div class="stack stack--16 measure">
        <span class="eyebrow">The lab</span>
        <h2 class="h-section">I don't just use SEO tools. I build them.</h2>
        <p class="muted">Custom tooling means faster research, cheaper reporting and data the team owns, not data rented from a SaaS dashboard.</p>
      </div>
      <ToolCards />
      <a class="btn btn--light self-start" href={url('/tools/')} data-cta="lab">See the tools</a>
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section id="work" class="container section">
    <h2 class="h-section">Selected work</h2>
    <div class="grid grid--320">
      {work.map((entry) => <CaseCard entry={entry} />)}
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="band-alt">
    <div class="container about">
      <Photo />
      <div class="stack">
        <span class="eyebrow">About</span>
        <h2 class="h-section">Hi, I'm Aayush.</h2>
        <p class="body-soft">
          I've spent 10+ years in search: eCommerce SEO in Chandigarh, measurement and experimentation at AKQA and R/GA
          in Melbourne, and now senior SEO and AI search work in Sydney.
        </p>
        <p class="body-soft">
          I'm looking for a senior SEO or AI search role where I can own strategy, get hands-on with the technical work
          and build the automation that makes a team faster. Based in Sydney, Australian Permanent Resident.
        </p>
        <div class="btn-row">
          <CvButton location="about" />
          <a class="btn btn--outline" href={url('/about/')} data-cta="about-more">More about me</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FREELANCE (secondary) -->
  <section id="freelance" class="container section section--tight">
    <div class="section-head">
      <div class="stack stack--16">
        <span class="eyebrow">Also available</span>
        <h2 class="h-section measure-h">Freelance projects</h2>
      </div>
      <p class="muted measure-p">
        I also take on a small number of freelance AI search and SEO projects.
      </p>
    </div>
    <FreelanceCards />
    <a class="btn btn--outline self-start" href={url('/freelance/')} data-cta="home-freelance">Freelance enquiries</a>
  </section>

  <ContactSection />
</Base>
