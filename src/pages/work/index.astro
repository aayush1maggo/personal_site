---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import ContactSection from '../../components/ContactSection.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="AI Search & SEO Case Studies | Aayush Maggo"
  description="AI search and SEO case studies: the problem, the approach and the measured result."
>
  <section class="container page-hero">
    <span class="eyebrow"><span class="marker" aria-hidden="true"></span>Case studies</span>
    <h1 class="h-hero">Selected work</h1>
    <p class="lede">Each case study follows the same shape: the problem, what I did about it, and the number that moved.</p>
  </section>
  <section class="container section section--after-hero">
    <div class="grid grid--320">
      {work.map((entry) => <CaseCard entry={entry} />)}
    </div>
  </section>
  <ContactSection />
</Base>
