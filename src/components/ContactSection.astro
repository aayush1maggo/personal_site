---
import ContactForm from './ContactForm.astro';
import CvButton from './CvButton.astro';
import { EMAIL, LINKEDIN_URL } from '../config';
import { url } from '../utils';

interface Props {
  id?: string;
  heading?: 'h1' | 'h2';
  idPrefix?: string;
}
const { id = 'contact', heading = 'h2', idPrefix = 'c' } = Astro.props;
const Heading = heading;
---

<section id={id} class="band-dark">
  <div class="container contact">
    <div class="stack">
      <Heading class="h-contact">Hiring for SEO or AI search? Let's talk.</Heading>
      <p class="muted measure-sm">
        Grab my CV, email me or send a message. I reply within one business day.
      </p>
      <CvButton variant="accent" class="self-start" location={`contact-${idPrefix}`} />
      <div class="contact__details">
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a href={LINKEDIN_URL}>LinkedIn</a>
      </div>
      <p class="small muted">
        Have a project instead? <a href={url('/freelance/')}>I take on freelance work too.</a>
      </p>
      <slot />
    </div>
    <ContactForm idPrefix={idPrefix} />
  </div>
</section>
