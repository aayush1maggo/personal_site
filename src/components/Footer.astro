---
import { CV_URL, EMAIL, LINKEDIN_URL } from '../config';
import { url } from '../utils';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <span>© {year} Aayush Maggo · Sydney, Australia</span>
    <span>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href={LINKEDIN_URL}>LinkedIn</a> ·
      <a href={url(CV_URL)} download data-cv data-cta="footer">CV</a>
    </span>
    <span>Open to roles · <a href={url('/freelance/')}>Freelance</a></span>
  </div>
</footer>
