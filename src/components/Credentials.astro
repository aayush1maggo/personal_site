---
import Skills from './Skills.astro';
import { awards, certifications, education } from '../data';
---

<div class="grid grid--260">
  <article class="card">
    <span class="eyebrow">Toolkit</span>
    <Skills />
  </article>
  <article class="card">
    <span class="eyebrow">Education</span>
    <ul class="creds">
      {education.map((e) => <li><strong>{e.title}</strong><span>{e.where}</span></li>)}
    </ul>
  </article>
  <article class="card">
    <span class="eyebrow">Certifications &amp; awards</span>
    <ul class="creds">
      {certifications.map((c) => <li><strong>{c.title}</strong><span>{c.where}</span></li>)}
      {awards.map((a) => <li><strong>{a}</strong><span>Winner</span></li>)}
    </ul>
  </article>
</div>
