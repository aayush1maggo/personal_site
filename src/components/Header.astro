---
import CvButton from './CvButton.astro';
import { url } from '../utils';

const links = [
  { href: '/#experience', label: 'Experience' },
  { href: '/work/', label: 'Work' },
  { href: '/tools/', label: 'Tools' },
  { href: '/about/', label: 'About' },
  { href: '/freelance/', label: 'Freelance' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')}>
      <span class="brand__mark" aria-hidden="true">AM</span>
      <span>Aayush Maggo</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {
        links.map(({ href, label }) => (
          <a href={url(href)} aria-current={!href.includes('#') && current.startsWith(url(href)) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <CvButton size="sm" location="nav" />
    </nav>
  </div>
</header>
