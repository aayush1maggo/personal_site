---
import { BOOKING_URL } from '../config';
import { url } from '../utils';

const links = [
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Case studies' },
  { href: '/tools/', label: 'Tools' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')}>
      <span class="brand__mark" aria-hidden="true">AM</span>
      <span>Aayush Maggo</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {
        links.map(({ href, label }) => (
          <a href={url(href)} aria-current={current.startsWith(url(href)) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <a class="btn btn--dark btn--sm" href={BOOKING_URL} data-booking data-cta="nav">Book a call</a>
    </nav>
  </div>
</header>
