---
import { FORMSPREE_ID } from '../config';
import { goals } from '../data';
import { url } from '../utils';

interface Props {
  idPrefix?: string;
  goal?: string;
}
const { idPrefix = 'c', goal = goals[0] } = Astro.props;
const thanks = new URL(url('/thanks/'), Astro.site).href;
const id = (name: string) => `${idPrefix}-${name}`;
---

<form class="form js-enquiry" action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST">
  <input type="hidden" name="_next" value={thanks} />
  <input type="hidden" name="_subject" value="New message from aayushmaggo.com" />
  <div class="honeypot" aria-hidden="true">
    <label for={id('gotcha')}>Leave this field empty</label>
    <input id={id('gotcha')} type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <label for={id('name')}>Name</label>
    <input id={id('name')} name="name" type="text" autocomplete="name" />
  </div>
  <div class="field">
    <label for={id('email')}>Email <span class="req">(required)</span></label>
    <input id={id('email')} name="email" type="email" autocomplete="email" required />
  </div>
  <div class="field">
    <label for={id('company')}>Company or website</label>
    <input id={id('company')} name="company" type="text" autocomplete="organization" />
  </div>
  <div class="field">
    <label for={id('goal')}>What's this about?</label>
    <select id={id('goal')} name="goal">
      {goals.map((g) => <option selected={g === goal}>{g}</option>)}
    </select>
  </div>
  <div class="field">
    <label for={id('message')}>Message</label>
    <textarea id={id('message')} name="message" rows="4"></textarea>
  </div>
  <button class="btn btn--light" type="submit" data-cta={`form-${idPrefix}`}>Send message</button>
  <p class="form__status small" role="status" aria-live="polite"></p>
</form>

<script define:vars={{ thanks }}>
  // AJAX submit so the free Formspree plan works; falls back to a normal POST with _next.
  document.querySelectorAll('.js-enquiry').forEach((form) => {
    if (form.dataset.bound) return;
    form.dataset.bound = '1';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.form__status');
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = thanks;
      } catch {
        status.textContent = 'Sorry, that didn’t send. Please email me directly instead.';
        button.disabled = false;
      }
    });
  });

  // Preselect the goal from ?goal=… (e.g. links from the freelance page).
  const goal = new URLSearchParams(location.search).get('goal');
  if (goal) {
    document.querySelectorAll('.js-enquiry select[name="goal"]').forEach((select) => {
      const match = [...select.options].find((o) => o.text === goal);
      if (match) select.value = match.value;
    });
  }
</script>
